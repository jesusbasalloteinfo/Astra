# ==============================================================================
# ASTRA PROJECT - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to '.env' and fill in the required values.
# ==============================================================================

# --- DATABASE CONFIGURATION (MongoDB) ---
# Used by astra_api and astra_auth services.
DB_USER=admin
DB_PASSWORD=secret_password
DB_HOST=astra_api_db
DB_PORT=27017
DB_NAME=astra

# --- LITELLM SECURITY & PROXY KEYS ---
# Master key for managing the LiteLLM proxy.
LITELLM_MASTER_KEY=sk-astra-master-key-change-me
# Salt key used for internal encryption/hashing within LiteLLM.
LITELLM_SALT_KEY=sk-astra-salt-key-change-me

# --- LITELLM DATABASE CONFIGURATION (PostgreSQL) ---
# Used for LiteLLM state persistence.
LLM_DB_USER=llm_user
LLM_DB_PASSWORD=llm_password
LLM_DB_NAME=litellm

# --- LLM API ROUTING ---
# The internal URL where LiteLLM proxy is listening.
LLM_API_BASE=http://litellm:5000/v1
# The key used by astra_api to communicate with LiteLLM proxy.
LLM_API_KEY=sk-astra-internal-communication-key

# --- EXTERNAL AI PROVIDER ---
# Your real API key for the AI provider (e.g., Google Gemini, OpenAI, Anthropic).
# This key is used by LiteLLM to perform the actual requests.
AI_API_KEY=your_real_api_key_here

# --- DEBUG & DEVELOPMENT ---
# Set to 'true' to enable technical logs and debug tools in the UI.
USER_DEBUG=false
# Set to 'true' for verbose logging in backend services.
DEBUG=false
